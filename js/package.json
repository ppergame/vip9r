{
  "name": "vip9r-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm build:d8 && pnpm build:web && pnpm build:pi-harness",
    "build:d8": "vite build --config vite.d8.config.ts",
