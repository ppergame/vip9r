    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.3"
  }
}
